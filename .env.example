# MarketPilot Environment Variables
# Copy this file to .env and fill in your actual API keys

# ==================== Internal Price API ====================
# Our own OHLCV Price Data API
PRICE_API_BASE_URL=your_price_api_base_url
# Optional: Add authentication if your API requires it
PRICE_API_KEY=your_api_key_here
PRICE_API_TOKEN=your_bearer_token_here

# ==================== External APIs (if needed) ====================

# Alpha Vantage API (for news)
# Get your free API key from: https://www.alphavantage.co/support/#api-key
ALPHAVANTAGE_API_KEY=your_alphavantage_api_key_here

# Financial Modeling Prep (FMP) API (for fundamentals)
# Get your free API key from: https://site.financialmodelingprep.com/developer/docs
FMP_API_KEY=your_fmp_api_key_here

# Finnhub API (alternative news source)
# Get your free API key from: https://finnhub.io/register
FINNHUB_API_KEY=your_finnhub_api_key_here

# ==================== Application Mode ====================
MARKETPILOT_MODE=test
